{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umg.envoy/schemas/review-decision-record.schema.json",
  "title": "UMG Review Decision Record Schema v0.1",
  "description": "Validating schema for static governance review decision records. Defines review decisions only and does not authorize implementation, execution, or release.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "review_type": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_packet_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_status": {
      "type": "string",
      "enum": ["accepted_static", "accepted_with_conditions", "rejected_static", "deferred", "blocked_security", "superseded"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "blocked_reasons": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "required_followups": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "reviewer_roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "implementation_allowed": {
      "type": "boolean",
      "const": false
    },
    "release_allowed": {
      "type": "boolean",
      "const": false
    },
    "security_gate_required": {
      "type": "boolean"
    }
  },
  "required": [
    "decision_id",
    "review_type",
    "reviewed_packet_id",
    "decision_status",
    "rationale",
    "conditions",
    "blocked_reasons",
    "required_followups",
    "reviewer_roles",
    "expires_at",
    "implementation_allowed",
    "release_allowed",
    "security_gate_required"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_status": { "const": "blocked_security" }
        },
        "required": ["decision_status"]
      },
      "then": {
        "properties": {
          "release_allowed": { "const": false },
          "security_gate_required": { "const": true }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": { "const": "rejected_static" }
        },
        "required": ["decision_status"]
      },
      "then": {
        "properties": {
          "implementation_allowed": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision_status": { "const": "accepted_with_conditions" }
        },
        "required": ["decision_status"]
      },
      "then": {
        "properties": {
          "conditions": { "minItems": 1 },
          "required_followups": { "minItems": 1 }
        }
      }
    }
  ]
}
