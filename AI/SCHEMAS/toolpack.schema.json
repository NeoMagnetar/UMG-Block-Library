{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umg.envoy/schemas/toolpack.schema.json",
  "title": "UMG Tool Pack Schema v0.2-draft",
  "description": "Validating schema for static UMG toolpack provider manifests. Defines provider supply only and does not grant execution authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identity": {
      "$ref": "./artifact.identity.schema.json"
    },
    "provenance": {
      "$ref": "./provenance.schema.json"
    },
    "toolpack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "toolpack_id": {
          "type": "string",
          "pattern": "^TP\\.[A-Z0-9._-]+\\.v[0-9]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provided_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CAP\\.[A-Z0-9._-]+\\.v[0-9]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "declared_tool_surfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tool_id": {
                "type": "string",
                "minLength": 1
              },
              "surface_kind": {
                "type": "string",
                "enum": ["read_only", "side_effect", "relay_orchestration", "bounded_execution"]
              },
              "description": {
                "type": ["string", "null"]
              },
              "approval_required": {
                "type": "boolean"
              }
            },
            "required": ["tool_id", "surface_kind", "approval_required"]
          },
          "minItems": 1
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^BIND\\.[A-Z0-9._-]+\\.v[0-9]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "trust_tier": {
              "type": "string",
              "enum": ["TRUST.INTERNAL", "TRUST.OPENCLAW_VERIFIED", "TRUST.BUSINESS_VERIFIED", "TRUST.EXPERIMENTAL", "TRUST.BLOCKED"]
            },
            "required_approvals": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "restricted_contexts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "required": ["trust_tier", "required_approvals", "restricted_contexts"]
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum_envoy_version": {
              "type": "string",
              "minLength": 1
            },
            "minimum_openclaw_version": {
              "type": "string",
              "minLength": 1
            },
            "supported_execution_modes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["preview", "dry_run", "assisted", "approved_execute", "blocked"]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "supported_platforms": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true
            },
            "required_plugin_config": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "required": [
            "minimum_envoy_version",
            "minimum_openclaw_version",
            "supported_execution_modes",
            "supported_platforms",
            "required_plugin_config"
          ]
        },
        "runtime_constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fail_closed": {
              "type": "boolean"
            },
            "bounded_execution_required": {
              "type": "boolean"
            },
            "tenant_binding_required": {
              "type": "boolean"
            },
            "notes": {
              "type": ["string", "null"]
            }
          },
          "required": ["fail_closed", "bounded_execution_required", "tenant_binding_required"]
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "emitted_events": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "blocked_reasons": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "validation_notes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "required": ["emitted_events", "blocked_reasons", "validation_notes"]
        },
        "failure_policy": {
          "type": "string",
          "enum": ["fail_closed", "warn_and_skip_optional", "defer_to_human", "stop_workflow"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      },
      "required": [
        "toolpack_id",
        "version",
        "provider",
        "provided_capabilities",
        "declared_tool_surfaces",
        "bindings",
        "permissions",
        "compatibility",
        "runtime_constraints",
        "diagnostics",
        "failure_policy"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "permissions": {
                "properties": {
                  "trust_tier": { "const": "TRUST.BLOCKED" }
                },
                "required": ["trust_tier"]
              }
            },
            "required": ["permissions"]
          },
          "then": {
            "properties": {
              "compatibility": {
                "properties": {
                  "supported_execution_modes": {
                    "maxItems": 1,
                    "items": { "const": "blocked" }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "declared_tool_surfaces": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "surface_kind": { "enum": ["side_effect", "relay_orchestration", "bounded_execution"] }
                  },
                  "required": ["surface_kind"]
                }
              }
            },
            "required": ["declared_tool_surfaces"]
          },
          "then": {
            "properties": {
              "runtime_constraints": {
                "properties": {
                  "bounded_execution_required": { "const": true }
                }
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  },
  "required": ["identity", "provenance", "toolpack"]
}
